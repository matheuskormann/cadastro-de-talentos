# Copie este arquivo para ".env" e preencha os valores. O ".env" não vai para o repositório.

# Chave da OpenAI usada na extração de currículos com IA (usarIa=true).
# Sem ela, a API continua funcionando com a extração por regex.
OPENAI_API_KEY=

# Opcionais: sobrescrevem o appsettings.json
# OpenAi__Modelo=gpt-4.1
# ConnectionStrings__CadastroTalentos=Server=localhost\SQLEXPRESS;Database=CadastroTalentos;Trusted_Connection=True;TrustServerCertificate=True
